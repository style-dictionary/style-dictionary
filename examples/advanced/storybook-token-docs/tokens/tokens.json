{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "500": { "$value": "#767676" },
      "900": { "$value": "#1a1a1a" }
    },
    "brand": {
      "primary": { "$value": "#0b5cad" },
      "accent": { "$value": "#f2a900" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.500}" }
    },
    "background": {
      "default": { "$value": "{color.neutral.0}" },
      "inverse": { "$value": "{color.neutral.900}" }
    }
  },
  "font": {
    "size": {
      "$type": "fontSize",
      "small": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "large": { "$value": "1.25rem" },
      "xlarge": { "$value": "1.5rem" },
      "xxlarge": { "$value": "2rem" }
    }
  },
  "space": {
    "$type": "dimension",
    "xsmall": { "$value": "0.25rem" },
    "small": { "$value": "0.5rem" },
    "medium": { "$value": "1rem" },
    "large": { "$value": "1.5rem" },
    "xlarge": { "$value": "2rem" }
  }
}
